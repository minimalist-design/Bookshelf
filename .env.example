# Bookshelf environment file (secrets only), installed by `make install` as ~/.secrets/bookshelf.env (mode 600)
# and passed to the service with systemd's EnvironmentFile=. Its settings live in the config file instead:
# run `bookshelf config path` to see where.

# ISBNdb API key (https://isbndb.com, account → API key). When set, ISBNdb is the first source for
# metadata lookups; its limits (calls per day, per second, ISBNs per bulk call) are in the config file.
ISBNDB_API_KEY=
