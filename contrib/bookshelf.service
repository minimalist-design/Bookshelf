# systemd user unit for the compiled binary (`make install` puts it in ~/.local/bin), for use without serviceman.
# Settings are in ~/.config/bookshelf/config.json (`bookshelf config path`); secrets, if any, in the env file.
[Unit]
Description=Bookshelf ebook library
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/bookshelf
Restart=on-failure
RestartSec=5
# %h is your home directory.
#EnvironmentFile=%h/.secrets/bookshelf.env

[Install]
WantedBy=default.target
